---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Carousel from '@/components/Carousel.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { url } from '@/utils/url';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const latestPosts = allPosts.slice(0, 6);
const categories = [...new Set(allPosts.map((post) => post.data.category))];
---

<BaseLayout
  title="AI datashake — Le blog GEO : Generative Engine Optimization"
  description="Découvrez le GEO (Generative Engine Optimization) : comment optimiser votre contenu pour les moteurs de recherche et l'IA générative. Stratégies, guides et analyses."
>
  <!-- Hero : fond beige, couleur signature datashake -->
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <p class="eyebrow hero__label">Generative Engine Optimization</p>
        <h1 class="hero__title">
          Optimisez votre visibilité pour l'IA générative
        </h1>
        <p class="hero__description">
          Le SEO évolue. Les moteurs de recherche intègrent l'IA générative dans leurs réponses.
          Découvrez comment adapter votre stratégie de contenu pour rester visible dans ce nouvel écosystème.
        </p>
        <div class="hero__actions">
          <a href={url('/blog/')} class="btn btn--primary">
            Explorer le blog
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Carousel des derniers articles -->
  <Carousel title="Derniers articles">
    {latestPosts.map((post) => (
      <ArticleCard
        title={post.data.title}
        description={post.data.description}
        date={post.data.date}
        category={post.data.category}
        slug={post.slug}
      />
    ))}
  </Carousel>

  <!-- Categories -->
  {categories.length > 0 && (
    <section class="section section--beige">
      <div class="container">
        <h2>Catégories</h2>
        <p class="section__intro">Explorez nos articles par thématique.</p>
        <div class="categories-grid">
          {categories.map((category) => {
            const categorySlug = category.toLowerCase().replace(/\s+/g, '-').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            const count = allPosts.filter((p) => p.data.category === category).length;
            return (
              <a href={url(`/categorie/${categorySlug}/`)} class="category-card">
                <h3 class="category-card__title">{category}</h3>
                <p class="category-card__count">
                  {count} article{count > 1 ? 's' : ''}
                </p>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* --- Hero --- */
  .hero {
    background-color: var(--ds-beige);
    padding: var(--spacing-4xl) 0;
  }

  .hero__content {
    max-width: 860px;
  }

  .hero__label {
    margin-bottom: var(--spacing-lg);
  }

  /* Titre : une seule graisse, noir 100 % */
  .hero__title {
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-title);
    letter-spacing: -0.03em;
    line-height: 1.08;
    max-width: 20ch;
    margin-bottom: var(--spacing-lg);
  }

  .hero__description {
    font-size: var(--font-size-lg);
    color: var(--text-body);
    line-height: 1.7;
    max-width: 62ch;
    margin-bottom: var(--spacing-xl);
  }

  .hero__actions {
    display: flex;
    gap: var(--spacing-md);
  }

  .section__intro {
    color: var(--text-body);
    margin-bottom: var(--spacing-xl);
  }

  /* --- Grille de categories : cartes blanches bordees --- */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--spacing-lg);
  }

  .category-card {
    display: block;
    padding: var(--spacing-xl);
    background: var(--ds-white);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-card);
    text-decoration: none;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .category-card:hover {
    border-color: var(--ds-black);
    transform: translateY(-2px);
    opacity: 1;
  }

  .category-card__title {
    font-size: var(--font-size-xl);
    color: var(--text-strong);
    margin-bottom: var(--spacing-xs);
  }

  .category-card__count {
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--spacing-2xl) 0;
    }

    .hero__title {
      font-size: var(--font-size-3xl);
      max-width: none;
    }
  }
</style>
