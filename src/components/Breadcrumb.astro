---
import SchemaOrg from './SchemaOrg.astro';
import { getLang, localizedUrl, t } from '@/utils/i18n';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const lang = getLang(Astro.url);

const allItems: BreadcrumbItem[] = [
  { name: lang === 'en' ? 'Home' : 'Accueil', url: localizedUrl('/', lang) },
  ...items,
];
---

<SchemaOrg type="breadcrumb" breadcrumbs={allItems} />

<nav aria-label={lang === 'en' ? 'Breadcrumb' : "Fil d'Ariane"} class="breadcrumb">
  <ol>
    {allItems.map((item, index) => (
      <li>
        {index < allItems.length - 1 ? (
          <a href={item.url}>{item.name}</a>
        ) : (
          <span aria-current="page">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb {
    padding: var(--spacing-md) 0;
    font-size: var(--font-size-xs);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--spacing-xs);
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--text-muted);
  }

  .breadcrumb li:not(:last-child)::after {
    content: '/';
    color: var(--text-faint);
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--text-strong);
    opacity: 1;
  }

  .breadcrumb span[aria-current] {
    color: var(--text-body);
  }
</style>
